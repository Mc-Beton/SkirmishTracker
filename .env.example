# Backend (Spring Boot) – defaults in application.yml work for local development.
DB_URL=jdbc:postgresql://localhost:5432/skirmish
DB_USER=skirmish
DB_PASSWORD=skirmish
# Generate with: openssl rand -base64 48
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
SECURE_COOKIES=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@warbracket.local

# Google / Discord login (optional): SPRING_PROFILES_ACTIVE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Frontend (Next.js)
BACKEND_URL=http://localhost:8080
