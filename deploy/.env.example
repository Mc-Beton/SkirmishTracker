# Copy to deploy/.env on the server (never commit the real file) and fill in.
DOMAIN=warbracket.pl
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# openssl rand -base64 32
DB_PASSWORD=
# openssl rand -base64 48   (at least 32 bytes)
JWT_SECRET=

# SMTP for verification and password-reset e-mails (registration needs them).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@warbracket.pl
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Contact form (/support) messages are forwarded here; Reply-To is the sender.
SUPPORT_INBOX=

# Optional Google / Discord login: SPRING_PROFILES_ACTIVE=oauth plus the IDs below.
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
